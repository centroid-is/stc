<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Name>Demo</Name>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GVLs\GVL_Main.TcGVL">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="GVLs\GVL_Quoted.TcGVL">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="DUTs\ST_Point.TcDUT">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="DUTs\E_Mode.TcDUT">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\MAIN.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\FB_Motor.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\I_Motor.TcIO">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\F_Add.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="PlcTask.TcTTO">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Visu\Screen.TcVIS">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PlaceholderReference Include="DemoLib">
      <DefaultResolution>DemoLib, * (Demo)</DefaultResolution>
      <Namespace>DemoLib</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc2_EtherCAT">
      <DefaultResolution>Tc2_EtherCAT, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc2_EtherCAT</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc2_Standard">
      <DefaultResolution>Tc2_Standard, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc2_Standard</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc2_System">
      <DefaultResolution>Tc2_System, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc2_System</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc3_Module">
      <DefaultResolution>Tc3_Module, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc3_Module</Namespace>
      <SystemLibrary>true</SystemLibrary>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc2_SerialCom">
      <DefaultResolution>Tc2_SerialCom, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc2_SerialCom</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc2_Missing">
      <DefaultResolution>Tc2_Missing, * (Nobody)</DefaultResolution>
      <Namespace>Tc2_Missing</Namespace>
    </PlaceholderReference>
  </ItemGroup>
  <ItemGroup>
    <PlaceholderResolution Include="Tc2_EtherCAT">
      <Resolution>Tc2_EtherCAT, * (Beckhoff Automation GmbH)</Resolution>
    </PlaceholderResolution>
  </ItemGroup>
</Project>
