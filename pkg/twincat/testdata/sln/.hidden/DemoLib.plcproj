<!-- Decoy: a dot-directory copy that the sibling search must never pick. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Compile Include="POUs\DOES_NOT_EXIST.TcPOU" />
  </ItemGroup>
</Project>
